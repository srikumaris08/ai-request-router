{
  "name": "ai-routing-backend",
  "version": "1.0.0",
  "description": "AI-powered customer request routing system — backend service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec node src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@google/generative-ai": "^0.24.1",
    "openai": "^6.42.0"
  }
}
